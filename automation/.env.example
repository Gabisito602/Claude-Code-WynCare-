# Copia este archivo a ".env" (nunca subas el ".env" real — está en .gitignore)
# y rellena los valores reales. Este worker necesita la service_role key de
# Supabase (no la anon key) porque tiene que leer/escribir rating_jobs y
# quotes de CUALQUIER usuario, no solo el suyo — por eso corre en un
# servidor propio, nunca en el navegador del cliente.

SUPABASE_URL=https://gpcavoymhsivyorkxbam.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Portal del agente de la aseguradora (uno por aseguradora integrada).
INSURER_PORTAL_URL=
INSURER_USER=
INSURER_PASS=
